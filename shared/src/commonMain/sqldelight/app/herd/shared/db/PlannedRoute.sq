-- Routes planned ahead: the line and totals as routed, and their points in plan_point.
CREATE TABLE planned_route (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  avoid_highways INTEGER NOT NULL,
  avoid_tolls INTEGER NOT NULL,
  -- The routed line, as a polyline with 6 digits of precision.
  geometry TEXT NOT NULL,
  distance_m REAL NOT NULL,
  duration_s REAL NOT NULL,
  -- Epoch milliseconds.
  updated_at INTEGER NOT NULL
);

CREATE TABLE plan_point (
  route_id INTEGER NOT NULL,
  position INTEGER NOT NULL,
  name TEXT NOT NULL,
  subtitle TEXT,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  pass_through INTEGER NOT NULL,
  PRIMARY KEY (route_id, position)
);

insertRoute:
INSERT INTO planned_route(name, avoid_highways, avoid_tolls, geometry, distance_m, duration_s, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateRoute:
UPDATE planned_route
SET name = ?, avoid_highways = ?, avoid_tolls = ?, geometry = ?, distance_m = ?, duration_s = ?, updated_at = ?
WHERE id = ?;

insertPoint:
INSERT INTO plan_point VALUES ?;

deletePoints:
DELETE FROM plan_point WHERE route_id = :routeId;

deleteRoute:
DELETE FROM planned_route WHERE id = :id;

summaries:
SELECT planned_route.id, planned_route.name, planned_route.distance_m, planned_route.duration_s,
  (SELECT count(*) FROM plan_point WHERE plan_point.route_id = planned_route.id) AS point_count
FROM planned_route
ORDER BY updated_at DESC, id DESC;

route:
SELECT * FROM planned_route WHERE id = :id;

points:
SELECT * FROM plan_point WHERE route_id = :routeId ORDER BY position;
